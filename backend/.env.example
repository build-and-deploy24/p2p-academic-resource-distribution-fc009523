# Backend configuration.
#
# Copy this file to `.env` and replace the placeholder values. Never commit a
# real `.env`. The backend currently reads these variables from the process
# environment, so set them in your shell (for example
# `$env:ADMIN_UPLOAD_TOKEN="..."` in PowerShell) until an env-file loader is
# wired into the dev script.

# Address the API listens on. Defaults: 3000 / 127.0.0.1.
PORT=3000
HOST=127.0.0.1

# Directory holding the authoritative file bytes. Defaults to backend/storage.
FILE_STORAGE_DIR=./storage

# Token required in the X-Upload-Token header by POST /api/units/:unitId/files.
# Uploads are refused with 503 while this is unset. Use a long random value,
# for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_UPLOAD_TOKEN=replace-with-a-long-random-value

# Maximum accepted upload size in bytes. Defaults to 26214400 (25 MiB).
MAX_UPLOAD_BYTES=26214400
